# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4100
NODE_ENV=development

# Where the frontend runs. Comma-separated for multiple origins.
# Local: http://localhost:3100   Staging: https://app.yourdomain.com
CORS_ORIGIN=http://localhost:3100

# Public base URL of the FRONTEND — used to build the shareable /a/<id> link.
APP_URL=http://localhost:3100

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string → URI.
# Use the "Session pooler" string when deploying somewhere with limited sockets.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ─── Supabase Auth ───────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe on a server; it is not a secret
# in the way the service role key is, but keep it server-side anyway.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Retell AI ───────────────────────────────────────────────────────────────
# https://dashboard.retellai.com → Settings → API Keys
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxx

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Optional. Compiles the intake form into a production-quality Retell prompt.
# Unset = the deterministic fallback compiler is used instead.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ─── reCAPTCHA v2 (checkbox) ─────────────────────────────────────────────────
# https://www.google.com/recaptcha/admin → register the SECRET key here.
# The matching site key goes in apps/web/.env.local.
# Test key that always passes (local dev only): 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
