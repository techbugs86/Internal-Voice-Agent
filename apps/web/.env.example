# Where the backend lives. Server-side only — the browser never calls the API
# directly; it goes through this app's own /api routes, which attach the session.
# Local: http://localhost:4100   Staging: https://api.yourdomain.com
API_URL=http://localhost:4100

# Public base URL of THIS app. Used for redirects and the email-confirmation
# link target.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# reCAPTCHA v2 (checkbox) SITE key — this one is public and appears in the HTML.
# The matching secret key goes in apps/api/.env.
# https://www.google.com/recaptcha/admin
# Test key that always passes (local dev only): 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
